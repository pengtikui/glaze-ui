---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { SiteHeaderIsland } from '@/docs/islands/SiteHeaderIsland'
---

<BaseLayout title="页面未找到 · Glaze UI">
  <SiteHeaderIsland pathname="/404" client:load />
  <main class="mx-auto flex min-h-[70vh] max-w-[640px] flex-col items-center justify-center gap-4 px-6 text-center">
    <div class="rounded-tile bg-white p-10">
      <h1 class="m-0 font-glaze-display text-[36px] font-extrabold text-[#123A5C]">404</h1>
      <p class="m-0 mt-2 text-[15px] text-[#5B6170]">未找到该文档页面或组件路由。</p>
      <div class="mt-6 flex flex-wrap justify-center gap-2.5">
        <a
          href="/"
          class="inline-flex h-11 items-center rounded-full bg-[#123A5C] px-5 text-[14px] font-semibold text-white no-underline hover:bg-[#194A73]"
        >
          返回首页
        </a>
        <a
          href="/docs"
          class="inline-flex h-11 items-center rounded-full bg-[#F2F3F5] px-5 text-[14px] font-semibold text-[#1B1F27] no-underline hover:bg-[#E8EBF0]"
        >
          进入文档
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
