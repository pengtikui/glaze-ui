---
import { getCollection, render } from 'astro:content'
import DocsLayout from '@/layouts/DocsLayout.astro'
import { AiEndpointsIsland, FoundationsIsland } from '@/docs/islands/PageIslands'

export async function getStaticPaths() {
  const entries = await getCollection('docs')
  return entries
    .filter((entry) => entry.id !== 'index')
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const toc = headings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({ id: h.slug, label: h.text, depth: h.depth }))
---

<DocsLayout title={`${entry.data.title} · Glaze UI`} description={entry.data.description} toc={toc}>
  <article class="flex flex-col gap-7">
    <header class="flex flex-col gap-2">
      <h1 class="m-0 font-glaze-display text-[34px] leading-10 font-extrabold tracking-[-0.02em] text-[#123A5C]">
        {entry.data.title}
      </h1>
      <p class="m-0 text-[15px] text-[#5B6170]">{entry.data.description}</p>
    </header>

    {entry.data.interactiveWidget === 'ai-endpoints' && (
      <AiEndpointsIsland client:load />
    )}

    <div class="docs-prose">
      <Content />
    </div>

    {entry.data.interactiveWidget === 'foundations' && (
      <div class="pt-2">
        <FoundationsIsland client:only="react" />
      </div>
    )}
  </article>
</DocsLayout>
