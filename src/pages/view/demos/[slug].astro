---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { DEMOS_LIST } from '@/docs/data/catalog'
import { StandaloneDemoIsland } from '@/docs/islands/PageIslands'

export async function getStaticPaths() {
  return DEMOS_LIST.map((demo) => ({
    params: { slug: demo.slug },
    props: { demo },
  }))
}

const { demo } = Astro.props
---

<BaseLayout title={`${demo.title} · Glaze Demo`} description={demo.description} clientRouter={false}>
  <StandaloneDemoIsland slug={demo.slug} client:only="react" />
</BaseLayout>
