---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { BLOCKS_LIST } from '@/docs/data/catalog'
import { StandaloneBlockIsland } from '@/docs/islands/PageIslands'

export async function getStaticPaths() {
  return BLOCKS_LIST.map((block) => ({
    params: { slug: block.slug },
    props: { block },
  }))
}

const { block } = Astro.props
---

<BaseLayout title={`${block.title} · Glaze Block`} description={block.description} clientRouter={false}>
  <StandaloneBlockIsland slug={block.slug} client:only="react" />
</BaseLayout>
