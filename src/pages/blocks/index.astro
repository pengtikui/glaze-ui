---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { BLOCKS_LIST } from '@/docs/data/catalog'
import { SiteHeaderIsland } from '@/docs/islands/SiteHeaderIsland'
import { BlocksIndexIsland } from '@/docs/islands/PageIslands'
---

<BaseLayout
  title={`Blocks (${BLOCKS_LIST.length}) · Glaze UI`}
  description={`${BLOCKS_LIST.length} 个基于基础组件与卡片封装的通用业务区块`}
>
  <SiteHeaderIsland pathname="/blocks" client:load />
  <BlocksIndexIsland client:only="react" />
</BaseLayout>
