{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "profile-summary-card",
  "type": "registry:component",
  "title": "W12 人物名片摘要卡 (ProfileSummaryCard)",
  "description": "人物名片摘要卡（W12 · 尺寸 W）— 头像 · 职位 · 状态 · 3 指标",
  "registryDependencies": [
    "@glaze/avatar",
    "@glaze/status-pill",
    "@glaze/style",
    "@glaze/tile",
    "@glaze/tokens"
  ],
  "categories": [
    "cards",
    "collaboration",
    "size-w"
  ],
  "files": [
    {
      "path": "registry/glaze/cards/profile-summary-card.tsx",
      "type": "registry:component",
      "target": "components/cards/profile-summary-card.tsx",
      "content": "import { Avatar } from '@/components/ui/avatar'\nimport { StatusPill } from '@/components/ui/status-pill'\nimport { Tile } from '@/components/ui/tile'\nimport { TILE_THEMES, type Hue, type Status, type TileTone } from '@/lib/tokens'\n\nexport function ProfileSummaryCard({\n  name,\n  role,\n  initials,\n  hue = 'periwinkle',\n  status = 'normal',\n  statusLabel = '在线办公',\n  stats,\n  tone = 'white',\n}: {\n  name: string\n  role: string\n  initials: string\n  hue?: Hue\n  status?: Status\n  statusLabel?: string\n  stats: { label: string; value: string }[]\n  tone?: TileTone\n}) {\n  const theme = TILE_THEMES[tone]\n  return (\n    <Tile size=\"w\" tone={tone} className=\"justify-between\">\n      <div className=\"flex items-center justify-between gap-3\">\n        <div className=\"flex min-w-0 items-center gap-3\">\n          <Avatar fallback={initials} hue={hue} size=\"lg\" />\n          <div className=\"min-w-0\">\n            <div className=\"truncate font-glaze-display text-[18px] font-extrabold\">{name}</div>\n            <div className=\"truncate text-[12px]\" style={{ color: theme.soft }}>\n              {role}\n            </div>\n          </div>\n        </div>\n        <StatusPill status={status} label={statusLabel} size=\"sm\" />\n      </div>\n      <div\n        className=\"grid grid-cols-3 gap-3 rounded-inner px-4 py-2.5\"\n        style={{\n          backgroundColor: theme.dark\n            ? 'rgba(255,255,255,0.1)'\n            : theme.bg === '#FFFFFF'\n              ? '#F6F7F9'\n              : 'rgba(255,255,255,0.65)',\n        }}\n      >\n        {stats.map((s) => (\n          <div key={s.label} className=\"min-w-0\">\n            <div className=\"truncate text-[11px]\" style={{ color: theme.soft }}>\n              {s.label}\n            </div>\n            <div className=\"truncate font-glaze-display text-[18px] font-extrabold\" style={{ color: theme.ink }}>\n              {s.value}\n            </div>\n          </div>\n        ))}\n      </div>\n    </Tile>\n  )\n}\n"
    }
  ]
}
